{
  "name": "@volter/twin-catalog",
  "version": "0.1.0",
  "description": "The moderated twin distribution: approved versions and submission tooling for independent publishers.",
  "type": "module",
  "bin": {
    "twin-catalog": "bin/twin-catalog.mjs"
  },
  "exports": {
    "./browse": {
      "types": "./lib/browse.d.mts",
      "default": "./lib/browse.mjs"
    },
    "./*": "./*"
  },
  "engines": {
    "node": ">=22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-catalog-open.git"
  },
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "files": [
    "sources.json",
    "vendors",
    "README.md",
    "LICENSE",
    "catalog.json",
    "recommendations.json",
    "revocations.json",
    "policy.json",
    "bin",
    "lib",
    "runner",
    "docs",
    "evidence"
  ]
}
