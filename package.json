{
  "name": "@volter/twin-catalog",
  "version": "0.1.0",
  "description": "The moderated twin distribution: approved versions and submission tooling for independent publishers.",
  "type": "module",
  "bin": {
    "twin-catalog": "bin/twin-catalog.mjs"
  },
  "exports": {
    "./browse": {
      "types": "./lib/browse.d.mts",
      "default": "./lib/browse.mjs"
    },
    "./*": "./*"
  },
  "engines": {
    "node": ">=22.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-catalog-open.git"
  },
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "dependencies": {
    "@npmcli/config": "10.13.0",
    "make-fetch-happen": "15.0.6",
    "npm-registry-fetch": "19.1.1",
    "yaml": "2.9.0",
    "sigstore": "4.1.1",
    "semver": "7.8.5",
    "tar": "7.5.7"
  },
  "files": [
    "sources.json",
    "vendors",
    "README.md",
    "LICENSE",
    "catalog.json",
    "recommendations.json",
    "revocations.json",
    "policy.json",
    "facts",
    "bin",
    "lib",
    "docs",
    "evidence",
    "content"
  ],
  "publishConfig": {
    "access": "public"
  }
}
